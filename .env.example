# Chỉ dùng ở server runtime. Không đưa khóa này vào client bundle hoặc commit giá trị thật.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Origin public duy nhất của ứng dụng, dùng khi HTTPS kết thúc tại reverse proxy.
# Ví dụ production: https://nic.example.vn (không kèm path hoặc dấu / cuối).
APP_ORIGIN=
SLA_CRON_SECRET=
P2_CRON_SECRET=
RETENTION_CRON_SECRET=
ENTERPRISE_AUTH_REQUIRED=0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_DOMAIN=
OIDC_AUTO_PROVISION=0
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng ở server runtime/CI bảo mật; bypass RLS, không đưa vào client bundle.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Private bucket; public access must stay disabled.
SUPABASE_ATTACHMENT_BUCKET=nic-attachments
DATABASE_POOL_SIZE=10
ATTACHMENT_SCAN_CRON_SECRET=
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
